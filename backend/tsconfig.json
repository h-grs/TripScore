{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "NodeNext", // ← au lieu de "CommonJS"
    "moduleResolution": "NodeNext", // ← au lieu de "node"
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "types": ["jest", "node"],
    "outDir": "dist",
    "rootDir": "."
  },
  "include": ["src", "tests"]
}
